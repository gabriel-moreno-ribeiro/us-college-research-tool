# US College Research Tool — Environment Variables
# Copy this to .env and fill in your API keys

# === Required for local stdio mode ===
# Get a free key at: https://api.data.gov/signup/
COLLEGE_SCORECARD_API_KEY=

# === Optional (improves rate limits) ===
# Get a free key at: https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=

# === OpenAlex polite pool (optional) ===
# Setting this gets you into OpenAlex's "polite pool" with higher rate limits
# Use any valid email address
OPENALEX_MAILTO=your-email@example.com

# === HTTP Mode (for remote deployment) ===
# Set to 'http' to run as a remote connector (default: stdio)
MCP_TRANSPORT=stdio

# Port for HTTP mode (default: 8000)
PORT=8000

# === Note for HTTP/Remote Mode ===
# When MCP_TRANSPORT=http, API keys should be sent via HTTP headers by clients:
#   X-College-Scorecard-Key: <user's key>
#   X-Semantic-Scholar-Key: <user's key>
# Environment variables are only used as fallback for local stdio development.
