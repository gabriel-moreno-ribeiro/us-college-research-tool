{
  "mcpServers": {
    "us-college-research": {
      "type": "http",
      "url": "https://us-college-research-tool.onrender.com/mcp",
      "headers": {
        "X-College-Scorecard-Key": "${userConfig.COLLEGE_SCORECARD_API_KEY}",
        "X-Semantic-Scholar-Key": "${userConfig.SEMANTIC_SCHOLAR_API_KEY}"
      }
    },
    "firecrawl": {
      "type": "http",
      "url": "https://mcp.firecrawl.dev/v2/mcp",
      "headers": {
        "Authorization": "Bearer ${userConfig.FIRECRAWL_API_KEY}"
      }
    },
    "exa": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": "${userConfig.EXA_API_KEY}"
      }
    }
  }
}
